# ---------------- Godot 4 ----------------
# 编辑器缓存与导入产物：可由 `--import` 或打开编辑器自动重建，不要提交
.godot/
.import/

# 导出预设常含本机绝对路径
export_presets.cfg
export.cfg

# 导出产物
build/
*.pck
*.zip

# C# / Mono（本工程是纯 GDScript，留着以防将来接 C#）
.mono/
data_*/
mono_crash.*.json

# ---------------- 系统杂项 ----------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

# ---------------- 调试产出 ----------------
# `-- --shot` 截图模式默认写到工程外的 _shots/，若被改到工程内则忽略
_shots/

# ---------------- 第三方编辑器插件 ----------------
# godot-ai MCP 插件只在本地开发时用，不入库。安装方式见 README「可选：godot-ai MCP 插件」。
# 该插件会往 project.godot 写入 [editor_plugins] 段和 _mcp_game_helper autoload，
# 仓库里的 project.godot 保持干净版本（不含这两处）。
addons/

# 运行期存档（自动保存 / 脏备份），不入库
userdata/
