; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="绗间腑澧熷奖 / Ghost in the Iron Shell"
config/description="绉戝够妯澘鍔ㄤ綔鑲夐附銆傚墤銆佺浘銆侀摮涓変綅涓€浣擄紝骞界伒褰㈡€侀獓鍏ョ綉缁溿€?
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="cage-shadow"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=120

[autoload]

Events="*res://scripts/core/events.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; 閿佸畾鍏ㄥ睆锛? = Exclusive Fullscreen锛堢嫭鍗犲叏灞忥級銆? = Fullscreen 鏄?; 銆屾棤杈规绐楀彛銆嶏紝Windows 浠诲姟鏍忎細娴湪鐢婚潰涔嬩笂锛涚嫭鍗犲叏灞忔墠鐪熸鎺ョ鏄剧ず鍣ㄣ€?window/size/mode=4
window/size/resizable=false
; viewport锛氭暣骞呯敾闈㈡寜 1280x720 娓叉煋鍚庣粺涓€缂╂斁锛岀獥鍙ｅ昂瀵稿彉鍖栨椂
; Control 甯冨眬涓嶇敤閫愬抚閲嶇畻锛屾嫋绐?缂╂斁鏄庢樉鏇磋窡鎵嬨€?window/stretch/mode="viewport"
; expand锛氱敾闈㈡寜姣斾緥鎵╁睍鍒板～婊℃暣鍧楀睆骞曪紝涓嶇暀榛戣竟銆?window/stretch/aspect="expand"
; 鎷栧姩绐楀彛鏃?Windows 浼氳繘鍏?modal move loop锛屽悓姝ョ瓑寰呭瀭鐩村悓姝ヤ細璁╃敾闈㈡槑鏄炬粸鍚庛€?window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="绗间腑澧熷奖 - Ghost in the Iron Shell"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
