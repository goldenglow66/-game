; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="笼中墟影 / Ghost in the Iron Shell"
config/description="科幻横板动作肉鸽。剑、盾、铳三位一体，幽灵形态骇入网络。"
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="cage-shadow"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Events="*res://scripts/core/events.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="笼中墟影 - Ghost in the Iron Shell"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="player_hitbox"
2d_physics/layer_7="enemy_hitbox"
2d_physics/layer_8="interactable"
2d_physics/layer_9="pickup"

[physics]

2d/default_gravity=1500.0

[rendering]

anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.043, 0.047, 0.066, 1)
