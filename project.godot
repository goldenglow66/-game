; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="笼中墟影 / Ghost in the Iron Shell"
config/description="科幻横板动作肉鸽。剑、盾、铳三位一体，幽灵形态骇入网络。"
run/main_scene="res://scenes/Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="cage-shadow"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=120

[autoload]

Events="*res://scripts/core/events.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; 锁定全屏：4 = Exclusive Fullscreen（独占全屏）。3 = Fullscreen 是
; 「无边框窗口」，Windows 任务栏会浮在画面之上；独占全屏才真正接管显示器。
window/size/mode=4
window/size/resizable=false
; viewport：整幅画面按 1280x720 渲染后统一缩放，窗口尺寸变化时
; Control 布局不用逐帧重算，拖窗/缩放明显更跟手。
window/stretch/mode="viewport"
; expand：画面按比例扩展到填满整块屏幕，不留黑边。
window/stretch/aspect="expand"
; 拖动窗口时 Windows 会进入 modal move loop，同步等待垂直同步会让画面明显滞后。
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="笼中墟影 - Ghost in the Iron Shell"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="player_hitbox"
2d_physics/layer_7="enemy_hitbox"
2d_physics/layer_8="interactable"
2d_physics/layer_9="pickup"

[physics]

2d/default_gravity=1500.0

[rendering]

; 2D 横板用 OpenGL 后端：启动快、显存占用低，Windows 下窗口交互也更稳。
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.043, 0.047, 0.066, 1)
